<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CodeMasters SSG</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="icon" href="/css/favicon.ico" />
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
                <img src="/images/logo.jpg" alt="CodeMasters" height="36" class="rounded" />
                CodeMasters SSG
            </a>
            <span class="navbar-text text-secondary small d-none d-md-block">
                UAB &middot; LEI &middot; 21179 LDS &middot; Equipa 1
            </span>
        </div>
    </nav>

    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-center">
        <span>&copy; 2026 CodeMasters &mdash; Laboratórios de Desenvolvimento de Software</span>
    </footer>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
