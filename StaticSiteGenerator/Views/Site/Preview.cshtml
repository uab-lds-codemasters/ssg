@model StaticSiteGenerator.Models.SiteEditorViewModel

@{
    ViewData["Title"] = "Pré-visualização";
    Layout = null;

    var placeholderBase = $@"<!DOCTYPE html>
<html lang=""pt"">
<head>
  <meta charset=""utf-8"" />
  <link id=""themeLink"" rel=""stylesheet"" href=""/css/{{THEME}}"" />
  <style>body {{ margin: 2rem; }} p {{ opacity: 0.6; font-style: italic; }}</style>
</head>
<body>
  <p>Página «{{0}}» — conteúdo a definir ({{1}}).</p>
</body>
</html>";
}

<!DOCTYPE html>
<html lang="pt" data-preview-theme="@Model.LandingPage.Theme">
<head>
    <meta charset="utf-8" />
    <title>@Model.LandingPage.Title</title>
    <link id="themeLink" rel="stylesheet" href="/css/@Model.LandingPage.Theme" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        /* Variáveis de cor por tema — aplicadas à shell de pré-visualização */

        /* Default */
        :root,
        [data-preview-theme="default.css"] {
            --sh-body-bg:       #f4f6f9;
            --sh-header-bg:     #1a3a5c;
            --sh-header-border: #4a90d9;
            --sh-header-title:  #ffffff;
            --sh-header-sub:    #9abcd4;
            --sh-nav-bg:        #ffffff;
            --sh-nav-border:    #cdd6e0;
            --sh-nav-text:      #3a5070;
            --sh-nav-hover:     #1e56a0;
            --sh-nav-active:    #1a3a5c;
            --sh-nav-accent:    #1e56a0;
            --sh-sub-bg:        #ffffff;
            --sh-sub-border:    #cdd6e0;
            --sh-sub-shadow:    rgba(26,58,92,0.12);
            --sh-sub-text:      #2c3a4a;
            --sh-sub-hover-bg:  #eef2f7;
            --sh-sub-hover-txt: #1e56a0;
            --sh-wrap-bg:       #f4f6f9;
            --sh-frame-border:  #bdc9d9;
            --sh-frame-shadow:  rgba(26,58,92,0.08);
            --sh-footer-bg:     #ffffff;
            --sh-footer-border: #cdd6e0;
            --sh-footer-link:   #1e56a0;
            --sh-footer-hover:  #1a3a5c;
            --sh-btn-text:      #cddcea;
            --sh-btn-active-bd: #4a90d9;
        }

        /* Light */
        [data-preview-theme="light.css"] {
            --sh-body-bg:       #eef2f7;
            --sh-header-bg:     #1e4976;
            --sh-header-border: #2563a8;
            --sh-header-title:  #f0f6ff;
            --sh-header-sub:    #8ab4d4;
            --sh-nav-bg:        #f5f8fc;
            --sh-nav-border:    #bdc9d9;
            --sh-nav-text:      #2c3a4a;
            --sh-nav-hover:     #2563a8;
            --sh-nav-active:    #1e4976;
            --sh-nav-accent:    #2563a8;
            --sh-sub-bg:        #f5f8fc;
            --sh-sub-border:    #bdc9d9;
            --sh-sub-shadow:    rgba(30,73,118,0.10);
            --sh-sub-text:      #2c3a4a;
            --sh-sub-hover-bg:  #dde8f2;
            --sh-sub-hover-txt: #1e4976;
            --sh-wrap-bg:       #eef2f7;
            --sh-frame-border:  #b0c2d6;
            --sh-frame-shadow:  rgba(30,73,118,0.07);
            --sh-footer-bg:     #f5f8fc;
            --sh-footer-border: #bdc9d9;
            --sh-footer-link:   #2563a8;
            --sh-footer-hover:  #1e4976;
            --sh-btn-text:      #cddcea;
            --sh-btn-active-bd: #2563a8;
        }

        /* Dark */
        [data-preview-theme="dark.css"] {
            --sh-body-bg:       #0d1b2a;
            --sh-header-bg:     #07101a;
            --sh-header-border: #1e56a0;
            --sh-header-title:  #d0dff0;
            --sh-header-sub:    #3d607f;
            --sh-nav-bg:        #111d2b;
            --sh-nav-border:    #1e3a55;
            --sh-nav-text:      #7a96b0;
            --sh-nav-hover:     #4a90d9;
            --sh-nav-active:    #cdd8e8;
            --sh-nav-accent:    #4a90d9;
            --sh-sub-bg:        #162032;
            --sh-sub-border:    #1e3a55;
            --sh-sub-shadow:    rgba(0,0,0,0.35);
            --sh-sub-text:      #8ab0cc;
            --sh-sub-hover-bg:  #1e3348;
            --sh-sub-hover-txt: #74b3f0;
            --sh-wrap-bg:       #0d1b2a;
            --sh-frame-border:  #1e3a55;
            --sh-frame-shadow:  rgba(0,0,0,0.3);
            --sh-footer-bg:     #111d2b;
            --sh-footer-border: #1e3a55;
            --sh-footer-link:   #4a90d9;
            --sh-footer-hover:  #74b3f0;
            --sh-btn-text:      #7a9ab8;
            --sh-btn-active-bd: #4a90d9;
        }

        /* Estilos da shell */

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: var(--sh-body-bg);
            color: var(--sh-nav-text);
            transition: background 0.25s, color 0.25s;
        }

        /* Cabeçalho */
        .site-header {
            padding: 1.2rem 2.5rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            background: var(--sh-header-bg);
            border-bottom: 3px solid var(--sh-header-border);
            transition: background 0.25s, border-color 0.25s;
        }

        .site-header-text h1 {
            margin: 0 0 0.15rem;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--sh-header-title);
            letter-spacing: -0.01em;
        }
        .site-header-text p {
            margin: 0;
            font-size: 0.85rem;
            color: var(--sh-header-sub);
        }

        /* Botões de tema */
        .theme-switcher {
            display: flex;
            gap: 0.4rem;
            align-items: center;
            flex-shrink: 0;
        }

        .theme-switcher span {
            font-size: 0.72rem;
            color: var(--sh-header-sub);
            margin-right: 0.3rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .theme-btn {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.28rem 0.65rem;
            border-radius: 20px;
            border: 2px solid transparent;
            cursor: pointer;
            font-size: 0.75rem;
            font-weight: 500;
            transition: border-color 0.2s, background 0.2s;
            background: rgba(255,255,255,0.08);
            color: var(--sh-btn-text);
        }

        .theme-btn:hover { background: rgba(255,255,255,0.16); }

        .theme-btn.active {
            border-color: var(--sh-btn-active-bd);
            background: rgba(74,144,217,0.18);
            color: var(--sh-header-title);
        }

        .theme-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.25);
            flex-shrink: 0;
        }

        /* Navegação */
        nav {
            padding: 0 2rem;
            background: var(--sh-nav-bg);
            border-bottom: 2px solid var(--sh-nav-border);
            display: flex;
            flex-wrap: wrap;
            gap: 0;
            transition: background 0.25s, border-color 0.25s;
        }

        nav a {
            padding: 0.65rem 1rem;
            text-decoration: none;
            cursor: pointer;
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--sh-nav-text);
            border-bottom: 3px solid transparent;
            transition: color 0.15s, border-color 0.15s;
            display: inline-block;
        }

        nav a:hover { color: var(--sh-nav-hover); border-bottom-color: var(--sh-nav-accent); }
        nav a.active { color: var(--sh-nav-active); border-bottom-color: var(--sh-nav-accent); font-weight: 700; }

        /* Submenu dropdown */
        .nav-item {
            position: relative;
            display: inline-block;
        }

        .nav-item > a::after {
            content: ' ▾';
            font-size: 0.72em;
            opacity: 0.55;
        }

        .submenu {
            display: none;
            position: absolute;
            top: calc(100% + 2px);
            left: 0;
            min-width: 150px;
            background: var(--sh-sub-bg);
            border: 1px solid var(--sh-sub-border);
            border-radius: 6px;
            box-shadow: 0 4px 12px var(--sh-sub-shadow);
            overflow: hidden;
            z-index: 100;
            transition: background 0.25s;
        }

        .nav-item:hover .submenu,
        .nav-item:focus-within .submenu { display: block; }

        .submenu a {
            display: block;
            padding: 0.5rem 1.1rem;
            border-radius: 0;
            border-bottom: none;
            color: var(--sh-sub-text);
            font-size: 0.85rem;
        }

        .submenu a:hover {
            background: var(--sh-sub-hover-bg);
            color: var(--sh-sub-hover-txt);
        }

        /* Área da frame */
        .content-frame-wrapper {
            flex: 1;
            padding: 1.5rem 2.5rem;
            background: var(--sh-wrap-bg);
            transition: background 0.25s;
        }

        #contentFrame {
            width: 100%;
            height: 430px;
            border: 1px solid var(--sh-frame-border);
            border-radius: 6px;
            background: white;
            box-shadow: 0 2px 8px var(--sh-frame-shadow);
            transition: border-color 0.25s, box-shadow 0.25s;
        }

        /* Rodapé */
        .site-footer {
            padding: 0.75rem 2.5rem;
            background: var(--sh-footer-bg);
            border-top: 1px solid var(--sh-footer-border);
            font-size: 0.82rem;
            display: flex;
            justify-content: flex-end;
            transition: background 0.25s, border-color 0.25s;
        }

        .site-footer a {
            text-decoration: none;
            color: var(--sh-footer-link);
            font-weight: 500;
            transition: color 0.15s;
        }
        .site-footer a:hover { text-decoration: underline; color: var(--sh-footer-hover); }
    </style>
</head>
<body>

    <div class="site-header">
        <div class="site-header-text">
            <h1>@Model.LandingPage.Title</h1>
            <p>@Model.LandingPage.Subtitle</p>
        </div>

        <div class="theme-switcher">
            <span>Tema:</span>
            <button class="theme-btn" data-theme="default.css" onclick="setTheme(this)">
                <span class="theme-dot" style="background:#ffffff;"></span> Default
            </button>
            <button class="theme-btn" data-theme="light.css" onclick="setTheme(this)">
                <span class="theme-dot" style="background:#eef2f7;"></span> Light
            </button>
            <button class="theme-btn" data-theme="dark.css" onclick="setTheme(this)">
                <span class="theme-dot" style="background:#0d1b2a;"></span> Dark
            </button>
        </div>
    </div>

    <nav id="siteNav"></nav>

    <div class="content-frame-wrapper">
        <iframe id="contentFrame" title="Conteúdo da página"></iframe>
    </div>

    <div class="site-footer">
        <a href="/Site/Index">&#8592; Voltar ao editor</a>
    </div>

    <script>
        const siteTitle    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LandingPage.Title));
        const siteSubtitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LandingPage.Subtitle));
        const placeholderBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(placeholderBase));
        const menuData     = @Html.Raw(Model.MenuJson);

        let currentTheme = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LandingPage.Theme));

        // Aplica o tema à shell inteira (atributo no <html>) e recarrega a frame
        function setTheme(btn) {
            currentTheme = btn.getAttribute('data-theme');

            // Muda a CSS global da shell
            document.documentElement.setAttribute('data-preview-theme', currentTheme);
            document.getElementById('themeLink').href = `/css/${currentTheme}`;

            // Marca botão activo
            document.querySelectorAll('.theme-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Recarrega a página activa na frame com o novo tema
            const active = document.querySelector('#siteNav a.active');
            if (active) loadPage(active);
        }

        // Constrói o nav com suporte a submenus (children)
        function buildNav() {
            const nav = document.getElementById('siteNav');
            nav.innerHTML = '';

            menuData.forEach(item => {
                if (item.children && item.children.length > 0) {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'nav-item';
                    wrapper.setAttribute('tabindex', '0');

                    const parent = document.createElement('a');
                    parent.href = '#';
                    parent.textContent = item.title;
                    parent.onclick = e => e.preventDefault();
                    wrapper.appendChild(parent);

                    const submenu = document.createElement('div');
                    submenu.className = 'submenu';

                    item.children.forEach(child => {
                        const link = document.createElement('a');
                        link.href = '#';
                        link.textContent = child.title;
                        link.setAttribute('data-href', child.link || '#');
                        link.setAttribute('data-title', child.title);
                        link.onclick = e => { e.preventDefault(); loadPage(link); };
                        submenu.appendChild(link);
                    });

                    wrapper.appendChild(submenu);
                    nav.appendChild(wrapper);
                } else {
                    const link = document.createElement('a');
                    link.href = '#';
                    link.textContent = item.title;
                    link.setAttribute('data-href', item.link || '#');
                    link.setAttribute('data-title', item.title);
                    link.onclick = e => { e.preventDefault(); loadPage(link); };
                    nav.appendChild(link);
                }
            });
        }

        function buildHomeDoc(theme) {
            const ts = Date.now();
            return `<!DOCTYPE html><html lang="pt"><head><meta charset="utf-8"/>`
                 + `<title>${siteTitle}</title>`
                 + `<link rel="stylesheet" href="/css/${theme}?v=${ts}"/>`
                 + `<style>body{margin:2rem}</style></head><body>`
                 + `<h1>${siteTitle}</h1><p>${siteSubtitle}</p>`
                 + `</body></html>`;
        }

        function buildPlaceholder(theme, title, link) {
            const ts = Date.now();
            return placeholderBase
                .replace('{THEME}', theme + '?v=' + ts)
                .replace('{0}', title)
                .replace('{1}', link);
        }

        function loadPage(link) {
            const href  = link.getAttribute('data-href');
            const title = link.getAttribute('data-title');
            const frame = document.getElementById('contentFrame');

            if (href === '/') {
                frame.removeAttribute('src');
                frame.srcdoc = buildHomeDoc(currentTheme);
            } else if (href.startsWith('http://') || href.startsWith('https://')) {
                window.open(href, '_blank');
                frame.removeAttribute('src');
                frame.srcdoc = buildPlaceholder(currentTheme, title, '&#8599; aberto em nova aba');
            } else {
                frame.removeAttribute('src');
                frame.srcdoc = buildPlaceholder(currentTheme, title, href);
            }

            document.querySelectorAll('#siteNav a').forEach(a => a.classList.remove('active'));
            link.classList.add('active');
        }

        // Marca o botão de tema inicial como activo
        const initialBtn = document.querySelector(`.theme-btn[data-theme="${currentTheme}"]`);
        if (initialBtn) initialBtn.classList.add('active');

        // Constrói o nav e abre "Início" automaticamente
        buildNav();
        const inicio = document.querySelector('#siteNav a[data-href="/"]')
                    || document.querySelector('#siteNav a');
        if (inicio) loadPage(inicio);
    </script>

</body>
</html>
