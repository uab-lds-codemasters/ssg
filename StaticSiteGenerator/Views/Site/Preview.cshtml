@model StaticSiteGenerator.Models.SiteEditorViewModel

@{
    ViewData["Title"] = "Pré-visualização";
    Layout = null;
    var temaAtual = Model.LandingPage!.Theme;

    bool IsExterno(string url) =>
        !string.IsNullOrWhiteSpace(url) &&
        (url.StartsWith("http://") || url.StartsWith("https://"));
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.LandingPage.Title</title>
    <link id="temaCSS" rel="stylesheet" href="/css/@temaAtual" />
    <style>
        .nav-temas { display: flex; align-items: center; gap: 6px; }
        .nav-temas span { font-size: 0.8rem; opacity: 0.75; }
        .btn-tema {
            font-size: 0.78rem;
            padding: 3px 10px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.4);
            background: transparent;
            color: inherit;
            cursor: pointer;
            opacity: 0.75;
            transition: opacity 0.2s, background 0.2s;
            text-decoration: none;
        }
        .btn-tema:hover { opacity: 1; background: rgba(255,255,255,0.15); }
        .btn-tema.ativo { opacity: 1; background: rgba(255,255,255,0.25); border-color: rgba(255,255,255,0.8); font-weight: bold; }
    </style>
</head>
<body data-tema="@temaAtual">
    <header>
        <div style="display: flex; align-items: center; gap: 16px;">
            <img src="~/css/img/logo.jpg" alt="Logo CodeMasters" style="height: 80px; width: auto; flex-shrink: 0;" />
            <div style="text-align: center; flex: 1;">
                <h1 style="margin-bottom: 4px;">@Model.LandingPage.Title</h1>
                <p class="subtitle" style="margin: 0;">@Model.LandingPage.Subtitle</p>
            </div>
        </div>
    </header>

    <nav style="justify-content: space-between;">
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            @foreach (var item in Model.MenuItems!)
            {
                if (item.Children != null && item.Children.Any())
                {
                    <div class="nav-dropdown">
                        <a href="@(string.IsNullOrWhiteSpace(item.Link) ? "#" : item.Link)"
                           class="nav-link-menu nav-dropdown-toggle"
                           @(IsExterno(item.Link) ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "")>@item.Title <span class="dropdown-arrow">&#9660;</span></a>
                        <div class="nav-dropdown-menu">
                            @foreach (var child in item.Children)
                            {
                                <a href="@child.Link" class="nav-link-menu"
                                   @(IsExterno(child.Link) ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "")>@child.Title</a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <a href="@item.Link" class="nav-link-menu"
                       @(IsExterno(item.Link) ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "")>@item.Title</a>
                }
            }
        </div>
        <div class="nav-temas">
            <a href="#" class="btn-tema" id="btn-default" onclick="Preview.mudarTema('default.css'); return false;">Default</a>
            <a href="#" class="btn-tema" id="btn-dark"    onclick="Preview.mudarTema('dark.css');    return false;">Dark</a>
            <a href="#" class="btn-tema" id="btn-light"   onclick="Preview.mudarTema('light.css');   return false;">Light</a>
        </div>
    </nav>

    <div id="frame-container" style="display:none;">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:6px 16px; background:rgba(0,0,0,0.05); border-bottom:1px solid rgba(0,0,0,0.1);">
            <div id="frame-aviso" style="display:none; font-size:0.85rem; align-items:center; gap:10px; flex:1;">
                <span>&#9888; Este site bloqueou a incorporação. Podes abri-lo numa nova aba:</span>
                <a id="link-nova-aba" href="#" target="_blank" class="btn-voltar" style="padding:4px 12px; font-size:0.8rem; margin-left:8px;">
                    Abrir em nova aba &#8599;
                </a>
            </div>
            <div style="flex:1;"></div>
            <button onclick="Preview.fecharIframe()" style="background:none; border:none; cursor:pointer; font-size:1.2rem; opacity:0.6; padding:2px 8px;" title="Fechar">&#10005;</button>
        </div>
        <iframe name="conteudo-frame" id="conteudo-frame"
                style="width:100%; min-height:500px; border:none; display:block;">
        </iframe>
    </div>

    <main>
        @if (!string.IsNullOrWhiteSpace(Model.LandingPage.ImagePath))
        {
            <img src="@Model.LandingPage.ImagePath" alt="@Model.LandingPage.Title"
                 style="max-width: 400px; max-height: 250px; width: 100%; height: auto; display: block; margin-bottom: 16px;" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.LandingPage.Content))
        {
            <p style="white-space: pre-wrap;">@Model.LandingPage.Content</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.LandingPage.DocumentPath))
        {
            <div style="margin-bottom: 16px;">
                <a href="@Model.LandingPage.DocumentPath" download="@Model.LandingPage.DocumentName" class="btn-voltar">
                    &#128196; Descarregar @Model.LandingPage.DocumentName
                </a>
            </div>
        }
        <a href="/Site/Index" class="btn-voltar">&#8592; Voltar ao editor</a>
    </main>

    <footer>
        <p>@(string.IsNullOrWhiteSpace(Model.LandingPage.Footer) ? "Gerado com CodeMasters SSG" : Model.LandingPage.Footer)</p>
    </footer>

    <script src="~/js/preview.js"></script>
</body>
</html>
