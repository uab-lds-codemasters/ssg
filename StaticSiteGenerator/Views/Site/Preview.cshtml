@model StaticSiteGenerator.Models.SiteEditorViewModel

@{
    ViewData["Title"] = "Pré-visualização";
    Layout = null;
    var temaAtual = Model.LandingPage.Theme;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.LandingPage.Title</title>
    <link id="temaCSS" rel="stylesheet" href="/css/@temaAtual" />
    <style>
        .nav-temas { display: flex; align-items: center; gap: 6px; }
        .nav-temas span { font-size: 0.8rem; opacity: 0.75; }
        .btn-tema {
            font-size: 0.78rem;
            padding: 3px 10px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.4);
            background: transparent;
            color: inherit;
            cursor: pointer;
            opacity: 0.75;
            transition: opacity 0.2s, background 0.2s;
            text-decoration: none;
        }
        .btn-tema:hover { opacity: 1; background: rgba(255,255,255,0.15); }
        .btn-tema.ativo { opacity: 1; background: rgba(255,255,255,0.25); border-color: rgba(255,255,255,0.8); font-weight: bold; }
    </style>
</head>
<body>
    <nav style="justify-content: space-between;">
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            @foreach (var item in Model.MenuItems)
            {
                <a href="@item.Link" class="nav-link-menu">@item.Title</a>
            }
        </div>
        <div class="nav-temas">
<a href="#" class="btn-tema" id="btn-default" onclick="mudarTema('default.css'); return false;">Default</a>
            <a href="#" class="btn-tema" id="btn-dark"    onclick="mudarTema('dark.css');    return false;">Dark</a>
            <a href="#" class="btn-tema" id="btn-light"   onclick="mudarTema('light.css');   return false;">Light</a>
        </div>
    </nav>

    <header>
        <h1>@Model.LandingPage.Title</h1>
        <p class="subtitle">@Model.LandingPage.Subtitle</p>
    </header>

    <main>
        @if (!string.IsNullOrWhiteSpace(Model.LandingPage.ImagePath))
        {
            <img src="@Model.LandingPage.ImagePath" alt="@Model.LandingPage.Title"
                 style="max-width: 100%; height: auto; display: block; margin-bottom: 16px;" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.LandingPage.Content))
        {
            <p style="white-space: pre-wrap;">@Model.LandingPage.Content</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.LandingPage.DocumentPath))
        {
            <div style="margin-bottom: 16px;">
                <a href="@Model.LandingPage.DocumentPath" download="@Model.LandingPage.DocumentName" class="btn-voltar">
                    &#128196; Descarregar @Model.LandingPage.DocumentName
                </a>
            </div>
        }
        <div id="frame-container" style="display:none; margin-bottom:16px;">
            <div id="frame-aviso" style="display:none; padding:12px 16px; background:rgba(0,0,0,0.05);
                 border-radius:6px 6px 0 0; border:1px solid rgba(0,0,0,0.1); border-bottom:none;
                 font-size:0.85rem; display:flex; align-items:center; justify-content:space-between;">
                <span>&#9888; Este site bloqueou a incorporação. Podes abri-lo numa nova aba:</span>
                <a id="link-nova-aba" href="#" target="_blank" class="btn-voltar" style="padding:4px 12px; font-size:0.8rem;">
                    Abrir em nova aba &#8599;
                </a>
            </div>
            <iframe name="conteudo-frame" id="conteudo-frame"
                    style="width:100%; min-height:400px; border:1px solid rgba(0,0,0,0.1); border-radius:6px;">
            </iframe>
        </div>
        <a href="/Site/Index" class="btn-voltar">&#8592; Voltar ao editor</a>
    </main>

    <footer>
        <p>@(string.IsNullOrWhiteSpace(Model.LandingPage.Footer) ? "Gerado com CodeMasters SSG" : Model.LandingPage.Footer)</p>
    </footer>

    <script>
        var temaAtual = '@temaAtual';

        function mudarTema(tema) {
            document.getElementById('temaCSS').href = '/css/' + tema;
            temaAtual = tema;
            document.querySelectorAll('.btn-tema').forEach(b => b.classList.remove('ativo'));
            var id = 'btn-' + tema.replace('.css', '');
            var btn = document.getElementById(id);
            if (btn) btn.classList.add('ativo');
        }

        // Marca o tema ativo ao carregar
        mudarTema(temaAtual);

        // Todos os links do menu abrem no iframe; "/" volta ao topo da preview
        document.querySelectorAll('.nav-link-menu').forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                var href = this.getAttribute('href');
                var frame = document.getElementById('conteudo-frame');
                var container = document.getElementById('frame-container');
                var aviso = document.getElementById('frame-aviso');
                var linkNovaAba = document.getElementById('link-nova-aba');

                // "/" ou "#" = página inicial = a própria preview
                if (href === '/' || href === '#' || href === '') {
                    container.style.display = 'none';
                    frame.src = '';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    return;
                }

                // Outros links: carrega no iframe
                container.style.display = 'block';
                aviso.style.display = 'none';
                frame.src = href;
                linkNovaAba.href = href;

                // Verifica se foi bloqueado após carregar
                frame.onload = function() {
                    try {
                        var doc = frame.contentDocument || frame.contentWindow.document;
                        if (!doc || doc.body === null || doc.body.innerHTML === '') {
                            aviso.style.display = 'flex';
                        }
                    } catch(err) {
                        aviso.style.display = 'flex';
                    }
                };
            });
        });
    </script>
</body>
</html>
