@model StaticSiteGenerator.Models.SiteEditorViewModel
@using Newtonsoft.Json
@using StaticSiteGenerator.Models
@using System.Collections.Generic

@{
    ViewData["Title"] = "Editor JSON";
    var landing = JsonConvert.DeserializeObject<LandingPage>(Model.LandingJson) ?? new LandingPage();
    var menuItems = JsonConvert.DeserializeObject<List<MenuItem>>(Model.MenuJson) ?? new List<MenuItem>();
}

<h1 class="mb-1">CodeMasters &#8212; Static Site Generator</h1>
<p class="text-muted mb-4">Preenche os campos abaixo e clica em <strong>Gerar</strong> para pré-visualizar o teu site.</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

@* enctype necessário para upload de ficheiros (backend pendente) *@
<form id="editorForm" action="/Site/Preview" method="post" enctype="multipart/form-data">
    <input type="hidden" name="landingJson" id="landingJsonHidden" />
    <input type="hidden" name="menuJson" id="menuJsonHidden" />

    <!-- Menu -->
    <div class="card mb-3">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            Menu de Navegação
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="adicionarItem()">+ Adicionar item</button>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-1 text-muted small px-1">
                <div class="col">Nome</div>
                <div class="col">Link</div>
                <div class="col-auto" style="width:46px"></div>
            </div>
            <div id="menuItems">
                @foreach (var item in menuItems)
                {
                    <div class="row g-2 mb-2 menu-item">
                        <div class="col">
                            <input type="text" class="form-control menu-title"
                                   placeholder="Ex: Início" value="@item.Title" />
                        </div>
                        <div class="col">
                            <input type="text" class="form-control menu-link"
                                   placeholder="Ex: /" value="@item.Link" />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-outline-danger"
                                    onclick="removerItem(this)">&#10005;</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Configuração -->
    <div class="card mb-3">
        <div class="card-header fw-bold">Configuração da Página</div>
        <div class="card-body">
            <div class="mb-3">
                <label for="siteTitle" class="form-label">Título</label>
                <input type="text" id="siteTitle" class="form-control"
                       value="@landing.Title" placeholder="Ex: O meu site" />
            </div>
            <div class="mb-3">
                <label for="siteSubtitle" class="form-label">Subtítulo</label>
                <input type="text" id="siteSubtitle" class="form-control"
                       value="@landing.Subtitle" placeholder="Ex: Bem-vindo ao meu site pessoal" />
            </div>
            <div class="mb-3">
                <label for="siteTheme" class="form-label">Tema</label>
                <select id="siteTheme" class="form-select">
                    <option value="default.css" @(landing.Theme == "default.css" ? "selected" : "")>Default — Azul</option>
                    <option value="dark.css"    @(landing.Theme == "dark.css"    ? "selected" : "")>Dark — Escuro</option>
                    <option value="light.css"   @(landing.Theme == "light.css"   ? "selected" : "")>Light — Azul Petróleo</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="siteContent" class="form-label">Conteúdo</label>
                <textarea id="siteContent" class="form-control" rows="10"
                          placeholder="Escreve aqui o conteúdo principal da tua página...">@landing.Content</textarea>
            </div>
            <div class="mb-3">
                <label for="siteImage" class="form-label">Imagem de Conteúdo</label>
                @if (!string.IsNullOrWhiteSpace(landing.ImagePath))
                {
                    <div class="mb-2">
                        <img src="@landing.ImagePath" alt="Imagem atual"
                             class="img-thumbnail" style="max-height: 150px;" />
                        <small class="text-muted d-block mt-1">Imagem atual. Seleciona outra para substituir.</small>
                    </div>
                }
                <input type="file" id="siteImage" name="image" class="form-control" accept="image/*" />
                <div id="imagePreview" class="mt-2 d-none">
                    <img id="previewImg" src="" alt="Pré-visualização"
                         class="img-thumbnail" style="max-height: 150px;" />
                    <small class="text-muted d-block mt-1">Pré-visualização — será guardada ao clicar Gerar.</small>
                </div>
            </div>
            <div class="mb-3">
                <label for="siteFooter" class="form-label">Rodapé</label>
                <input type="text" id="siteFooter" class="form-control"
                       value="@landing.Footer" placeholder="Ex: Gerado com CodeMasters SSG" />
            </div>
        </div>
    </div>

    <!-- Documentos -->
    <div class="card mb-3">
        <div class="card-header fw-bold">Documentos</div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(landing.DocumentPath))
            {
                <div class="alert alert-info d-flex align-items-center gap-2 py-2">
                    <span>&#128196;</span>
                    <span>Documento atual: <strong>@landing.DocumentName</strong></span>
                    <small class="text-muted ms-1">(seleciona outro para substituir)</small>
                </div>
            }
            <label for="siteDocument" class="form-label">Carregar documento</label>
            <input type="file" id="siteDocument" name="document" class="form-control"
                   accept=".docx,.xlsx,.pdf,.txt,.csv,.pptx" />
            <div id="docPreview" class="mt-2 d-none">
                <div class="alert alert-success d-flex align-items-center gap-2 py-2 mb-0">
                    <span>&#128196;</span>
                    <span>Selecionado: <strong id="docName"></strong></span>
                    <small class="text-muted ms-1">— será guardado ao clicar Gerar</small>
                </div>
            </div>
            <small class="form-text text-muted mt-1 d-block">
                Formatos aceites: .docx, .xlsx, .pdf, .txt, .csv, .pptx
            </small>
        </div>
    </div>

    <button type="submit" class="btn btn-primary px-4">Gerar</button>
</form>

<script>
    document.getElementById('siteDocument').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        document.getElementById('docName').textContent = file.name;
        document.getElementById('docPreview').classList.remove('d-none');
    });

    document.getElementById('siteImage').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (e) {
            document.getElementById('previewImg').src = e.target.result;
            document.getElementById('imagePreview').classList.remove('d-none');
        };
        reader.readAsDataURL(file);
    });

    function adicionarItem() {
        const container = document.getElementById('menuItems');
        const div = document.createElement('div');
        div.className = 'row g-2 mb-2 menu-item';
        div.innerHTML = `
            <div class="col">
                <input type="text" class="form-control menu-title" placeholder="Ex: Início" />
            </div>
            <div class="col">
                <input type="text" class="form-control menu-link" placeholder="Ex: /" />
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-outline-danger" onclick="removerItem(this)">&#10005;</button>
            </div>`;
        container.appendChild(div);
    }

    function removerItem(btn) {
        btn.closest('.menu-item').remove();
    }

    document.getElementById('editorForm').addEventListener('submit', function () {
        const landing = {
            title:     document.getElementById('siteTitle').value,
            subtitle:  document.getElementById('siteSubtitle').value,
            theme:     document.getElementById('siteTheme').value,
            content:   document.getElementById('siteContent').value,
            imagePath:    '@landing.ImagePath',
            documentPath: '@landing.DocumentPath',
            documentName: '@landing.DocumentName',
            footer:       document.getElementById('siteFooter').value
        };
        document.getElementById('landingJsonHidden').value = JSON.stringify(landing, null, 2);

        const items = [];
        document.querySelectorAll('.menu-item').forEach(row => {
            const title = row.querySelector('.menu-title').value.trim();
            const link  = row.querySelector('.menu-link').value.trim();
            if (title || link) items.push({ title, link });
        });
        document.getElementById('menuJsonHidden').value = JSON.stringify(items, null, 2);
    });
</script>
